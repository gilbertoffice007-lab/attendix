APP_ENV=development
# Neon connection string: copy it from the Neon dashboard and keep sslmode=require.
# Use the pooled hostname (it contains "-pooler") for serverless deployments.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Optional: override the SSL mode resolved from DATABASE_URL.
# DB_SSLMODE=require
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Allow faculty self-signup. Set false to make the workspace invitation-only.
ALLOW_PUBLIC_REGISTRATION=true
DEFAULT_ATTENDANCE_THRESHOLD=75
LOG_LEVEL=INFO

